#
# Nemesis System module configuration
#

[worldserver]

#
#    NemesisSystem.Enable
#        Description: Enables the Nemesis System module.
#        Default:     1 - enabled
#                     0 - disabled
#

NemesisSystem.Enable = 1

#
#    NemesisSystem.CitySiegeIntegration.Enable
#        Description: Allows active City Siege attackers and defenders to roll
#                     for nemesis promotion when they kill a real player.
#                     Siege-created nemeses are runtime-only because siege
#                     creatures are temporary summons.
#        Default:     0 - disabled
#                     1 - enabled
#

NemesisSystem.CitySiegeIntegration.Enable = 0

#
#    NemesisSystem.CitySiegeIntegration.Chance
#        Description: Percent chance for an active City Siege attacker or
#                     defender to trigger a nemesis promotion on a real-player
#                     kill when the integration is enabled.
#        Default:     10.0
#

NemesisSystem.CitySiegeIntegration.Chance = 10.0

#
#    NemesisSystem.MaxRank
#        Description: Maximum rank a nemesis can reach.
#        Default:     5
#

NemesisSystem.MaxRank = 5

#
#    NemesisSystem.HealthScalingReferenceLevel
#        Description: Level at which the full health ladder applies. Below it the health
#                     bonus is scaled towards 1.0, because base creature health grows far
#                     slower than player damage across the levels and a flat multiplier
#                     makes low-level nemeses unbeatable.
#                     Example: rank 5 on a level 40 mob is x6.0 at reference 0, but x3.5
#                     at reference 80.
#                     Set to 0 to always use the full multiplier (old behaviour).
#        Default:     80
#

NemesisSystem.HealthScalingReferenceLevel = 80

#
#    NemesisSystem.MinCreatureLevel
#        Description: Minimum creature level eligible to become a nemesis.
#        Default:     1
#

NemesisSystem.MinCreatureLevel = 1

#
#    NemesisSystem.MaxCreatureLevel
#        Description: Maximum creature level eligible to become a nemesis.
#        Default:     255
#

NemesisSystem.MaxCreatureLevel = 255

#
#    NemesisSystem.AllowNormal
#        Description: Allow normal-rank creatures to become nemeses.
#        Default:     1 - enabled
#                     0 - disabled
#

NemesisSystem.AllowNormal = 1

#
#    NemesisSystem.AllowElite
#        Description: Allow elite-rank creatures to become nemeses.
#        Default:     1 - enabled
#                     0 - disabled
#

NemesisSystem.AllowElite = 1

#
#    NemesisSystem.AllowRare
#        Description: Allow rare-rank creatures to become nemeses.
#        Default:     1 - enabled
#                     0 - disabled
#

NemesisSystem.AllowRare = 1

#
#    NemesisSystem.AllowRareElite
#        Description: Allow rare-elite creatures to become nemeses.
#        Default:     1 - enabled
#                     0 - disabled
#

NemesisSystem.AllowRareElite = 1

#
#    NemesisSystem.AllowWorldBoss
#        Description: Allow world-boss rank creatures to become nemeses.
#                     Dungeon and scripted bosses are still filtered separately.
#        Default:     0 - disabled
#

NemesisSystem.AllowWorldBoss = 0

#
#    NemesisSystem.RankUpCooldownSeconds
#        Description: Minimum time in seconds before the same creature can gain
#                     another nemesis promotion.
#        Default:     300
#

NemesisSystem.RankUpCooldownSeconds = 300

#
#    NemesisSystem.SameVictimCooldownSeconds
#        Description: Minimum time in seconds before the same player can feed
#                     another promotion to the same creature.
#        Default:     900
#

NemesisSystem.SameVictimCooldownSeconds = 900

#
#    NemesisSystem.PromotionLevelDiffMax
#        Description: Maximum absolute level difference allowed between the
#                     creature and the slain player for nemesis creation or
#                     rank-up.
#        Default:     5
#

NemesisSystem.PromotionLevelDiffMax = 5

#
#    NemesisSystem.TrivialKillLevelDelta
#        Description: Additional anti-trivial filter. If a creature is this
#                     many or more levels below the slain player, it cannot
#                     become or rank up as a nemesis.
#        Default:     5
#

NemesisSystem.TrivialKillLevelDelta = 5

#
#    NemesisSystem.DecayHours
#        Description: Deletes inactive nemesis state after this many hours.
#                     Set to 0 to disable decay.
#        Default:     48
#

NemesisSystem.DecayHours = 48

#
#    NemesisSystem.RevengeRewardItem
#        Description: Optional item reward granted when the original target or
#                     their party kills the nemesis.
#        Default:     0 - disabled
#

NemesisSystem.RevengeRewardItem = 0

#
#    NemesisSystem.RevengeRewardCount
#        Description: Count for the revenge reward item.
#        Default:     1
#

NemesisSystem.RevengeRewardCount = 1

#
#    NemesisSystem.RevengeRewardItemPerRankBonus
#        Description: Additional item count granted per rank above rank 1.
#        Default:     0
#

NemesisSystem.RevengeRewardItemPerRankBonus = 0

#
#    NemesisSystem.RevengeRewardGoldPerRankLevel
#        Description: Copper granted per nemesis rank per creature level on a
#                     revenge kill, split across nearby recipients and scaled by
#                     the level difference. Set to 0 to disable gold.
#        Default:     25
#

NemesisSystem.RevengeRewardGoldPerRankLevel = 25

#
#    NemesisSystem.BountyRewardItem
#        Description: Optional item reward granted when another player kills a
#                     nemesis that targets someone else.
#        Default:     0 - disabled
#

NemesisSystem.BountyRewardItem = 0

#
#    NemesisSystem.BountyRewardCount
#        Description: Count for the bounty reward item.
#        Default:     1
#

NemesisSystem.BountyRewardCount = 1

#
#    NemesisSystem.BountyRewardItemPerRankBonus
#        Description: Additional item count granted per rank above rank 1.
#        Default:     0
#

NemesisSystem.BountyRewardItemPerRankBonus = 0

#
#    NemesisSystem.BountyRewardGoldPerRankLevel
#        Description: Copper granted per nemesis rank per creature level on a
#                     bounty kill, split across nearby recipients and scaled by
#                     the level difference. Set to 0 to disable gold.
#        Default:     25
#

NemesisSystem.BountyRewardGoldPerRankLevel = 25

#
#    NemesisSystem.RewardOverlevelDiffMax
#        Description: Level difference at which reward scaling reaches zero.
#                     When the highest eligible recipient is this many levels
#                     above the nemesis, the kill grants no rewards. Set to 0
#                     to disable overlevel scaling.
#        Default:     5
#

NemesisSystem.RewardOverlevelDiffMax = 5

#
#    NemesisSystem.RewardUnderlevelDiffMax
#        Description: Level difference at which underdog scaling reaches its
#                     maximum multiplier. Set to 0 to disable underdog scaling.
#        Default:     5
#

NemesisSystem.RewardUnderlevelDiffMax = 5

#
#    NemesisSystem.RewardUnderdogMaxMultiplier
#        Description: Maximum reward multiplier granted when the highest
#                     eligible recipient is well below the nemesis level.
#        Default:     2.0
#

NemesisSystem.RewardUnderdogMaxMultiplier = 2.0

#
#    NemesisSystem.EnragedHealthPctThreshold
#        Description: Health percentage at or below which the Enraged affix becomes active.
#        Default:     30.0
#

NemesisSystem.EnragedHealthPctThreshold = 30.0

#
#    NemesisSystem.EnragedDamageMultiplier
#        Description: Damage multiplier applied while the Enraged affix is active.
#        Default:     1.50
#

NemesisSystem.EnragedDamageMultiplier = 1.50

#
#    NemesisSystem.MaxAffixDamageMultiplier
#        Description: Upper bound for the combined damage bonus of the Savage and
#                     Enraged affixes. Prevents the two from stacking into
#                     one-shot damage at high ranks.
#        Default:     2.50
#

NemesisSystem.MaxAffixDamageMultiplier = 2.50

#
#    NemesisSystem.VampiricHealPct
#        Description: Percent of the damage a Vampiric nemesis actually deals that is
#                     returned to it as healing. Combined with the Regenerating affix this
#                     is the strongest defensive pair in the system.
#        Default:     25.0
#

NemesisSystem.VampiricHealPct = 25.0

#
#    NemesisSystem.SwiftDamageMultiplier
#        Description: Damage bonus for the Swift affix. The core scales per-swing damage
#                     by attackTime/1000, so swinging faster alone leaves damage per
#                     second unchanged; this factor restores the lost damage and then
#                     some, which turns Swift into a real damage affix.
#                     Set to 1.0 to make Swift purely a movement-speed affix again.
#        Default:     1.25
#

NemesisSystem.SwiftDamageMultiplier = 1.25

#
#    NemesisSystem.RegenerationIntervalMs
#        Description: Tick interval in milliseconds for the Regenerating affix.
#        Default:     5000
#

NemesisSystem.RegenerationIntervalMs = 5000

#
#    NemesisSystem.RegenerationHealthPct
#        Description: Percent of max health restored each regeneration tick.
#        Default:     3.0
#

NemesisSystem.RegenerationHealthPct = 3.0

#
#    NemesisSystem.AnnounceOnCreate
#        Description: Sends nemesis creation and rank-up announcements to the
#                     nemesis zone. Reaching rank 5 is announced server-wide.
#        Default:     1 - enabled
#                     0 - disabled
#

NemesisSystem.AnnounceOnCreate = 1

#
#    NemesisSystem.AnnounceOnKill
#        Description: Sends nemesis kill announcements to the nemesis zone.
#        Default:     1 - enabled
#                     0 - disabled
#

NemesisSystem.AnnounceOnKill = 1

#
#    NemesisSystem.AnnounceMinRank
#        Description: Minimum nemesis rank required before announcements are sent.
#        Default:     1
#

NemesisSystem.AnnounceMinRank = 1

#
#    NemesisSystem.VisualAuraSpell
#        Description: Optional global aura override applied to active nemeses.
#                     When set to 0, rank-based aura settings below are used.
#                     Set to a spell id to force the same aura on every rank.
#        Default:     0 (disabled; use rank-based visuals)
#

NemesisSystem.VisualAuraSpell = 0

#
#    NemesisSystem.VisualAuraSpellRank1
#        Description: Aura spell used for rank 1 nemeses when the global
#                     visual aura override is disabled.
#        Default:     63130 (Trial of the Champion shield visual level 1)
#

NemesisSystem.VisualAuraSpellRank1 = 63130

#
#    NemesisSystem.VisualAuraSpellRank2
#        Description: Aura spell used for rank 2 nemeses when the global
#                     visual aura override is disabled.
#        Default:     63131 (Trial of the Champion shield visual level 2)
#

NemesisSystem.VisualAuraSpellRank2 = 63131

#
#    NemesisSystem.VisualAuraSpellRank3
#        Description: Aura spell used for rank 3 nemeses when the global
#                     visual aura override is disabled.
#        Default:     63132 (Trial of the Champion shield visual level 3)
#

NemesisSystem.VisualAuraSpellRank3 = 63132

#
#    NemesisSystem.VisualAuraSpellRank4
#        Description: Aura spell used for rank 4 nemeses when the global
#                     visual aura override is disabled.
#        Default:     45265 (Akil'zon static visual)
#

NemesisSystem.VisualAuraSpellRank4 = 45265

#
#    NemesisSystem.VisualAuraSpellRank5
#        Description: Aura spell used for rank 5 and higher nemeses when the
#                     global visual aura override is disabled.
#        Default:     28136 (Thaddius visual lightning)
#

NemesisSystem.VisualAuraSpellRank5 = 28136

#
#    NemesisSystem.AddonBootstrapRecentHours
#        Description: Recent nemeses within this many hours are included in
#                     player addon bootstrap responses, alongside rank 5 and
#                     relation-matched nemeses.
#        Default:     24
#

NemesisSystem.AddonBootstrapRecentHours = 24

#
#    NemesisSystem.AddonBootstrapMaxEntries
#        Description: Maximum number of nemesis entries sent in a filtered
#                     player addon bootstrap response.
#        Default:     100
#

NemesisSystem.AddonBootstrapMaxEntries = 100

#
#    NemesisSystem.AddonReportCooldownSeconds
#        Description: Minimum time between validated addon sighting updates for
#                     the same nemesis spawn.
#        Default:     30
#

NemesisSystem.AddonReportCooldownSeconds = 30

#
#    NemesisSystem.AddonReportMaxDistance
#        Description: Maximum distance in yards between the reporting player and
#                     the nemesis creature for an addon sighting to be accepted.
#                     Sightings are rejected when the nemesis is not loaded next
#                     to the player, which stops clients from relocating nemesis
#                     markers from anywhere on the map.
#                     Set to 0 to disable the distance check.
#        Default:     150.0
#

NemesisSystem.AddonReportMaxDistance = 150.0

#
#    NemesisSystem.LeaderboardMaxEntries
#        Description: How many rows the addon's monthly leaderboard request returns.
#        Default:     10
#

NemesisSystem.LeaderboardMaxEntries = 10

#
#    NemesisSystem.RankUpFlashVisual
#        Description: SpellVisualKit id played on the creature the moment it gains a rank,
#                     so nearby players notice the promotion instead of only reading it in
#                     chat. Preview ids in game with ".debug play visual <id>" (needs the
#                     debug cosmetic permission).
#                     Set to 0 to disable the flash.
#                     Known-valid examples: 179 (directed spell cast glow), 362 (salute).
#        Default:     179
#

NemesisSystem.RankUpFlashVisual = 179
